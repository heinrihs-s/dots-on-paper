# Start with the loopback defaults. For LAN devices, choose a reachable origin,
# add its hostname/IP to DOTS_ALLOWED_HOSTS, and adjust the host port bind yourself.
DOTS_PUBLIC_URL=http://127.0.0.1:9035
DOTS_ALLOWED_HOSTS=127.0.0.1,localhost
DOTS_PROFILE=trmnl_x
DOTS_REFRESH_SECONDS=60
# TRMNL sleep during thinking; boot, network and panel refresh add latency.
DOTS_THINKING_REFRESH_SECONDS=15
DOTS_FRAME_SECONDS=5
# Battery-friendly still images are the default. Opt in only on a tested panel.
DOTS_ANIMATE_THINKING=false
DOTS_THINKING_TIMEOUT_SECONDS=600
# Optional cloud-dependent Webhook Image plugin. Treat this URL as a password.
DOTS_TRMNL_WEBHOOK_URL=
DOTS_TRMNL_WEBHOOK_PROFILE=trmnl
# Existing BYOS identity only; no automatic enrollment or firmware changes.
DOTS_TRMNL_DEVICE_ID=
DOTS_TRMNL_ACCESS_TOKEN=
# Optional prebuilt beta; leave unset when building this checkout.
# DOTS_IMAGE=ghcr.io/heinrihs-s/dots-on-paper:0.2.0-beta.1
