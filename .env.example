# Start with the loopback defaults. For LAN devices, choose a reachable origin,
# add its hostname/IP to DOTS_ALLOWED_HOSTS, and adjust the host port bind yourself.
DOTS_PUBLIC_URL=http://127.0.0.1:9035
DOTS_ALLOWED_HOSTS=127.0.0.1,localhost
DOTS_PROFILE=trmnl_x
DOTS_REFRESH_SECONDS=60
DOTS_FRAME_SECONDS=5
# Existing BYOS identity only; no automatic enrollment or firmware changes.
DOTS_TRMNL_DEVICE_ID=
DOTS_TRMNL_ACCESS_TOKEN=
