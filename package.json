{
  "name": "dots-on-paper-tooling",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Optional development tools for the Dots on Paper demo and campaign",
  "scripts": {
    "test": "node --test tests/test_mcp.mjs",
    "media:export": "node demo/tools/export-campaign.mjs",
    "media:gifs": "node demo/tools/export-github.mjs",
    "media:verify": "python tools/finalize_campaign.py",
    "brand:svg": "python tools/build_brand.py",
    "brand:render": "node tools/build-brand.mjs",
    "visual:verify": "node demo/tools/verify-replies.mjs",
    "beta:verify": "node tools/verify-beta.mjs"
  },
  "engines": {"node": ">=22"},
  "devDependencies": {
    "playwright": "1.62.1",
    "sharp": "0.35.4"
  }
}
